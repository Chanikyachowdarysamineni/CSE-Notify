<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================================
         CSE Notify - Master Clean White/Black Theme
         ===================================================================== -->
    <style name="Theme.CSEHub" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/accent</item>
        <item name="colorTertiaryContainer">@color/warning_container</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorOnTertiaryContainer">@color/on_warning_container</item>

        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Surface / Background -->
        <!-- Clean solid color background -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        
        <!-- Outline for glass -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Status bar (Solid background) -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor" tools:targetApi="21">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Remove default Material shadows for minimal look -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialCardViewStyle">@style/Widget.CSEHub.CardView</item>

        <!-- Shape system (Slightly rounded, professional) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CSEHub.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CSEHub.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CSEHub.Large</item>
        
        <!-- Typography (White text, light font weights preferred for glass) -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CSEHub.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CSEHub.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.CSEHub.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CSEHub.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CSEHub.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.CSEHub.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CSEHub.LabelLarge</item>

    </style>

    <!-- =====================================================================
         Splash Screen theme
         ===================================================================== -->
    <style name="Theme.CSEHub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CSEHub</item>
    </style>

    <!-- =====================================================================
         Shape Appearance Overlays
         ===================================================================== -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImageView" parent="ShapeAppearanceOverlay.App.CornerSize50Percent" />

    <style name="ShapeAppearance.CSEHub.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.CSEHub.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.CSEHub.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item> <!-- Clean subtle radius -->
    </style>

    <!-- =====================================================================
         Component Styles (Glassmorphism)
         ===================================================================== -->
         
    <!-- Minimal clean cards: White, thin grey border, zero shadow -->
    <style name="Widget.CSEHub.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CSEHub.Medium</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@android:color/transparent</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@android:color/transparent</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.CSEHub.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item> <!-- Clean slightly rounded corners -->
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeWidth">0dp</item>
        <!-- Solid bold color -->
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- =====================================================================
         Text Appearances
         ===================================================================== -->
    <style name="TextAppearance.CSEHub.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    
    <style name="TextAppearance.CSEHub.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.CSEHub.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.CSEHub.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.CSEHub.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    
    <style name="TextAppearance.CSEHub.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    
    <style name="TextAppearance.CSEHub.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.CSEHub.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    
    <style name="TextAppearance.CSEHub.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.CSEHub.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
</resources>
