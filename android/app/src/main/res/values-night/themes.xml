<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================================
         CSE Notify — Premium Dark Mode Theme (Material Design 3 Hybrid)
         ===================================================================== -->
    <style name="Theme.CSEHub" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_container</item>

        <item name="colorSecondary">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary_container</item>
        <item name="colorSecondaryContainer">@color/secondary</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary</item>

        <item name="colorTertiary">@color/accent</item>
        <item name="colorTertiaryContainer">@color/warning_container</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorOnTertiaryContainer">@color/on_warning_container</item>

        <!-- Error colors -->
        <item name="colorError">#F87171</item> <!-- Red 400 -->
        <item name="colorErrorContainer">#991B1B</item> <!-- Red 800 -->
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorOnErrorContainer">#FEE2E2</item>

        <!-- Surface / Background (Dark) -->
        <item name="android:windowBackground">#09090B</item> <!-- Zinc 950 -->
        <item name="android:colorBackground">#09090B</item>
        <item name="colorOnBackground">#FAFAFA</item>
        <item name="colorSurface">#18181B</item> <!-- Zinc 900 -->
        <item name="colorSurfaceVariant">#27272A</item> <!-- Zinc 800 -->
        <item name="colorOnSurface">#FAFAFA</item>
        <item name="colorOnSurfaceVariant">#A1A1AA</item> <!-- Zinc 400 -->
        <item name="colorOutline">#3F3F46</item> <!-- Zinc 700 -->
        <item name="colorOutlineVariant">#27272A</item> <!-- Zinc 800 -->

        <!-- Status bar (Transparent or blend with background for modern look) -->
        <item name="android:statusBarColor" tools:targetApi="21">#09090B</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor" tools:targetApi="21">#09090B</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Flat aesthetic, no default shadows -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialCardViewStyle">@style/Widget.CSEHub.CardView</item>

        <!-- Shape system -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CSEHub.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CSEHub.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CSEHub.Large</item>
        
    </style>

    <style name="Theme.CSEHub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#09090B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CSEHub</item>
    </style>

    <!-- Typography mapping -->
    <style name="TextAppearance.CSEHub.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    
    <style name="TextAppearance.CSEHub.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.CSEHub.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.CSEHub.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.CSEHub.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    
    <style name="TextAppearance.CSEHub.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    
    <style name="TextAppearance.CSEHub.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
