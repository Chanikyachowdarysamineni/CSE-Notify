<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    style="@style/Widget.CSEHub.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- Left Time/Period Slot Indicator -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/periodText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P1"
                android:textAppearance="@style/TextAppearance.CSEHub.TitleLarge"
                android:textColor="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="09:00 AM\n10:00 AM"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CSEHub.BodySmall"/>
        </LinearLayout>

        <!-- Vertical Divider line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginHorizontal="16dp"/>

        <!-- Details Info area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/subjectText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compiler Design"
                android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium"/>

            <TextView
                android:id="@+id/subjectCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS602"
                android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/facultyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤 Dr. Rajesh Kumar"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodySmall"/>

                <TextView
                    android:id="@+id/roomText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚪 Room 304"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodySmall"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
