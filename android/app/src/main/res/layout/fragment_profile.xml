<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Profile Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="32dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profilePhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_profile"
                app:civ_border_width="2dp"
                app:civ_border_color="?attr/colorOutlineVariant"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textAppearance="@style/TextAppearance.CSEHub.HeadlineSmall"
                android:textColor="?attr/colorOnBackground" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:id="@+id/profileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student"
                    android:textColor="?attr/colorPrimary"
                    android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            style="@style/Widget.CSEHub.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium"
                    android:layout_marginBottom="16dp"/>

                <!-- Unique ID Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ID Number"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/detailId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22CSE1A001"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleSmall" />
                </LinearLayout>

                <!-- Mobile Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mobile Number"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/detailMobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91 9876543210"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleSmall" />
                </LinearLayout>

                <!-- College Email Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="College Email"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/detailCollegeEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="student@csehub.edu"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleSmall" />
                </LinearLayout>

                <!-- Section Field -->
                <LinearLayout
                    android:id="@+id/sectionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Section"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/detailSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleSmall" />
                </LinearLayout>

                <!-- Date of Birth Field -->
                <LinearLayout
                    android:id="@+id/dobContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date of Birth"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/detailDob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleSmall" />
                </LinearLayout>

                <!-- Day Scholar / Hosteller Field -->
                <LinearLayout
                    android:id="@+id/scholarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/detailScholar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleSmall" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Academic Performance Card (visible only to student) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cgpaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            style="@style/Widget.CSEHub.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Academic Performance"
                        android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cumulative GPA"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detailCgpa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.92"
                    android:textAppearance="@style/TextAppearance.CSEHub.HeadlineMedium"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/editButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Edit Contact Info"
            android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Settings &amp; Preferences"
            android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError"
            android:text="Log Out"
            android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
