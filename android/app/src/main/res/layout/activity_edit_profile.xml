<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Edit Profile"
            app:titleTextAppearance="@style/TextAppearance.CSEHub.TitleLarge"
            app:titleTextColor="?attr/colorOnBackground"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="?attr/colorOnBackground"/>
            
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Picture -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp">
                
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_profile"
                    app:civ_border_width="2dp"
                    app:civ_border_color="?attr/colorOutlineVariant"/>
                    
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabEditPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    app:srcCompat="@drawable/ic_edit"
                    app:fabSize="mini"
                    app:tint="?attr/colorOnPrimary"
                    app:backgroundTint="?attr/colorPrimary"
                    app:elevation="2dp"
                    android:contentDescription="Edit Photo"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academic Information (Read Only)"
                android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                
                <!-- Name (Read-only) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        android:inputType="none"
                        android:enabled="false"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Reg No (Read-only) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Registration No."
                        android:inputType="none"
                        android:enabled="false"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Details"
                android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Scholar/Hosteller -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilScholar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                    <AutoCompleteTextView
                        android:id="@+id/etScholar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Status"
                        android:focusable="false"
                        android:clickable="true"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DOB -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDob"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date of Birth"
                        android:focusable="false"
                        android:clickable="true"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Personal Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPersonalEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPersonalEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Personal Email"
                    android:inputType="textEmailAddress"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- College Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCollegeEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCollegeEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="College Email (@vignan.com)"
                    android:inputType="textEmailAddress"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mobile -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mobile Number"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                
                <!-- Aadhaar -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAadhaar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAadhaar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Aadhaar No."
                        android:inputType="number"
                        android:maxLength="12"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- PAN -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="PAN No."
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Professional Links"
                android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- GitHub -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGithub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="GitHub URL"
                    android:inputType="textUri"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
            </com.google.android.material.textfield.TextInputLayout>
            
            <!-- LinkedIn -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLinkedin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLinkedin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="LinkedIn URL"
                    android:inputType="textUri"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
            </com.google.android.material.textfield.TextInputLayout>
            
            <!-- LeetCode -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLeetcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLeetcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="LeetCode URL"
                    android:inputType="textUri"
                    android:textAppearance="@style/TextAppearance.CSEHub.BodyLarge"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Save Profile"
                android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
                app:cornerRadius="8dp"/>
                
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
