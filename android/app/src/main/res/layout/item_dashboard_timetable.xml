<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    style="@style/Widget.CSEHub.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                
                <TextView
                    android:id="@+id/periodText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P1"
                    android:textAppearance="@style/TextAppearance.CSEHub.LabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/timeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="09:00 - 10:00"
                android:textAppearance="@style/TextAppearance.CSEHub.BodySmall"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/subjectText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compiler Design"
            android:textAppearance="@style/TextAppearance.CSEHub.TitleMedium"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/roomText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Room 304"
            android:textAppearance="@style/TextAppearance.CSEHub.BodySmall"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
            
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

